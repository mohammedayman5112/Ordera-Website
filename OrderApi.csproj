<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Angular client (./client) and the test project (./tests) are built separately. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);client\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Show the Angular source in Solution Explorer for browsing and editing. They are "None" items: they take no
       part in the build or publish, and node_modules, dist and the lock file are deliberately left out. -->
  <ItemGroup>
    <None Include="client\src\**" />
    <None Include="client\angular.json;client\package.json;client\tsconfig*.json;client\proxy.conf.js;client\nginx.conf;client\Dockerfile;client\README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <!-- Referenced directly so projects that depend on this one (the tests) get the same EF Core version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
  </ItemGroup>

</Project>
